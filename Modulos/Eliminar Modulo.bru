meta {
  name: Eliminar Modulo
  type: http
  seq: 5
}

docs {
  # Eliminar Módulo
  
  Este endpoint permite eliminar (desactivar) un módulo del sistema.
  
  ## Descripción
  Realiza un soft delete del módulo, estableciendo su estado `esactivo` en `false`.
  
  ## Autenticación
  Requiere token JWT en el header `Authorization: Bearer {token}`
  Requiere permisos de autorización para acceder a este recurso
  
  ## Parámetros
  - `id`: ID del módulo (number, requerido en la URL)
  
  ## Respuesta Exitosa (200)
  ```json
  {
    "status": 200,
    "message": "Módulo eliminado con éxito",
    "data": true
  }
  ```
  
  ## Errores
  - `400`: El ID es requerido
  - `400`: Token inválido o expirado
  - `403`: No tienes permisos para acceder a este recurso
}

delete {
  url: {{base_url}}/api/v1/modules/delete/1
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}


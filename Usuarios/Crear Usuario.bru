meta {
  name: Crear Usuario
  type: http
  seq: 1
}

docs {
  # Crear Usuario
  
  Este endpoint permite crear un nuevo usuario en el sistema.
  
  ## Descripción
  Crea un nuevo usuario con todos los datos proporcionados. El email debe ser único.
  
  ## Autenticación
  Requiere token JWT en el header `Authorization: Bearer {token}`
  
  ## Body
  - `name`: Nombre del usuario (string, requerido)
  - `last_name`: Apellido del usuario (string, requerido)
  - `telf`: Teléfono del usuario (string, requerido)
  - `address`: Dirección del usuario (string, requerido)
  - `foto`: URL o nombre del archivo de foto (string, requerido)
  - `email`: Email único del usuario (string, requerido)
  - `type_user`: Nombre del tipo de usuario (string, requerido) - debe existir en la base de datos
  
  ## Respuesta Exitosa (201)
  ```json
  {
    "status": 201,
    "message": "Usuario creado con éxito",
    "data": {
      "id": 1,
      "name": "Juan",
      "last_name": "Pérez",
      "telf": "0987654321",
      "address": "Calle Principal 123",
      "foto": "foto.jpg",
      "email": "juan@example.com",
      "type_user": "Cliente"
    }
  }
  ```
  
  ## Errores
  - `400`: El email ya está registrado
  - `400`: Tipo de usuario no encontrado
  - `400`: Token inválido o expirado
  - `400`: Todos los campos son requeridos
}

post {
  url: {{base_url}}/api/v1/user/createUser
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Juan",
    "last_name": "Pérez",
    "telf": "0987654321",
    "address": "Calle Principal 123",
    "foto": "foto.jpg",
    "email": "juan@example.com",
    "type_user": "Cliente"
  }
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: Obtener Todos los Productos
  type: http
  seq: 2
}

docs {
  # Obtener Todos los Productos
  
  Este endpoint retorna una lista de todos los productos activos.
  
  ## Descripción
  Obtiene todos los productos que están activos en el sistema.
  
  ## Autenticación
  Requiere token JWT en el header `Authorization: Bearer {token}`
  
  ## Respuesta Exitosa (200)
  ```json
  {
    "status": 200,
    "message": "Productos obtenidos con éxito",
    "data": [
      {
        "id": 1,
        "name": "Camisa Polo",
        "code": "CAM-001",
        "description": "Camisa polo de algodón",
        "talla": "M",
        "color": "Azul",
        "foto": "camisa_polo.jpg",
        "category_id": 1
      }
    ]
  }
  ```
  
  ## Errores
  - `400`: Token inválido o expirado
}

get {
  url: {{base_url}}/api/v1/products/getAll
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
